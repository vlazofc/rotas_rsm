# ============================================================
# Rotas Brasil RSM — variáveis de ambiente
# Copie para .env e troque TODOS os valores "trocar_*"
# Nenhum segredo deve ir para o Git.
# ============================================================

# --- Aplicação ---
APP_NAME=Rotas Brasil RSM
APP_ENV=production            # development | production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
API_V1_PREFIX=/api
LOG_LEVEL=INFO

# --- Domínio / CORS ---
PUBLIC_DOMAIN=rotas.seudominio.com.br
# Liste o domínio do frontend e, se usar um subdomínio dedicado para a API
# (VITE_API_URL abaixo), inclua-o também — necessário para o CORS liberar
# as chamadas cross-origin do navegador.
ALLOWED_ORIGINS=https://rotas.seudominio.com.br,https://api.rotas.seudominio.com.br,http://localhost:5173

# Deixe vazio para a API ficar no mesmo domínio do frontend (caminho /api,
# via Caddy/Cloudflare Tunnel). Assim não precisa criar subdomínio de API.
VITE_API_URL=

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=admmendes_rotas_br
POSTGRES_USER=admmendes_rotas
POSTGRES_PASSWORD=trocar_senha_forte
# Host "postgres" = nome do serviço no docker-compose
DATABASE_URL=postgresql+psycopg://admmendes_rotas:trocar_senha_forte@postgres:5432/admmendes_rotas_br
# Pool por processo da API. Com 4 workers: até 28 conexões (4 × (5 + 2)).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Redis (broker Celery + cache) ---
REDIS_PASSWORD=trocar_senha_redis
REDIS_URL=redis://:trocar_senha_redis@redis:6379/0
CELERY_BROKER_URL=redis://:trocar_senha_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:trocar_senha_redis@redis:6379/2
API_RATE_LIMIT=6000/minute

# Concorrência HTTP. Comece com 4; use 2 × CPU + 1 apenas após medir CPU/RAM.
API_WORKERS=4

# --- MinIO (comprovantes e personalização/branding) ---
MINIO_ROOT_USER=admmendes
MINIO_ROOT_PASSWORD=trocar_senha_minio
MINIO_ENDPOINT=minio:9000
# Endpoint usado em URLs abertas pelo navegador (sem porta — o Caddy expõe os
# buckets em /comprovantes e /custom no mesmo domínio público; ver infra/Caddyfile).
# Em dev local com o proxy: localhost:8088.
MINIO_PUBLIC_ENDPOINT=rotas.seudominio.com.br
MINIO_USE_SSL=false
# Esquema das URLs assinadas que o navegador acessa. Em produção, o domínio público
# fica atrás de TLS (Cloudflare Tunnel + Caddy) mesmo com MINIO_USE_SSL=false
# internamente — por isso este flag é separado. Em dev local, deixe false.
MINIO_PUBLIC_SECURE=true
MINIO_BUCKET_PROOFS=comprovantes
MINIO_BUCKET_BRANDING=custom

# --- Segurança / JWT ---
# Gere com: openssl rand -hex 48
JWT_SECRET=trocar_chave_muito_forte_aleatoria
# Gere uma chave aleatória exclusiva; não reutilize nem exponha no frontend.
INTEGRATION_ENCRYPTION_KEY=trocar_chave_aleatoria_exclusiva_das_integracoes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

AUTH_MODE=local
MAX_UPLOAD_MB=25

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=cole_aqui_o_token_do_tunnel

# --- Usuário administrador semente (criado no primeiro boot se AUTH_MODE=local) ---
SEED_ADMIN_EMAIL=admin@admmendes.com.br
SEED_ADMIN_PASSWORD=trocar_admin_senha
SEED_ADMIN_NAME=Administrador Global

# --- Roteirização (router_run — maestro/GraphHopper) ---
# Em dev local: http://localhost:3005. Quando o router_run entrar na mesma
# rede docker da API, troque para http://maestro:3000.
ROUTER_BASE_URL=http://localhost:3005

# --- SharePoint (Microsoft Graph) — sincronização automática da planilha
# Torre de Controle do cliente. Vazio = sincronização desativada.
# Requer um app registrado no Entra ID do TENANT DO CLIENTE com permissão
# de aplicação Files.Read.All (ou Sites.Read.All), consentida pelo admin.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Link de compartilhamento do arquivo (Excel Online "Compartilhar" -> Copiar link)
SHAREPOINT_FILE_URL=
# Filial (branch_id) e endereço de origem usados para a importação automática.
SHAREPOINT_SYNC_BRANCH_ID=
SHAREPOINT_SYNC_ORIGIN_ADDRESS=

# --- Pesquisa de atualizações tributárias (Groq Compound + busca web) ---
GROQ_API_KEY=
GROQ_MODEL=groq/compound
# Agente Executivo (separado do motor de atualização tributária)
GROQ_API_EPORTS_KEY=
GROQ_REPORTS_MODEL=openai/gpt-oss-120b
