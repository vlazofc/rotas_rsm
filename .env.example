# ============================================================
# Rotas Brasil RSM — variáveis de ambiente
# Copie para .env e troque TODOS os valores "trocar_*"
# Nenhum segredo deve ir para o Git.
# ============================================================

# --- Aplicação ---
APP_NAME=Rotas Brasil RSM
APP_ENV=production            # development | production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
API_V1_PREFIX=/api
LOG_LEVEL=INFO

# --- Domínio / CORS ---
PUBLIC_DOMAIN=rotas.seudominio.com.br
# Liste o domínio do frontend e, se usar um subdomínio dedicado para a API
# (VITE_API_URL abaixo), inclua-o também — necessário para o CORS liberar
# as chamadas cross-origin do navegador.
ALLOWED_ORIGINS=https://rotas.seudominio.com.br,https://api.rotas.seudominio.com.br,http://localhost:5173

# Deixe vazio para a API ficar no mesmo domínio do frontend (caminho /api,
# via Caddy/Cloudflare Tunnel). Assim não precisa criar subdomínio de API.
VITE_API_URL=

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=admmendes_rotas_pt
POSTGRES_USER=admmendes_rotas
POSTGRES_PASSWORD=trocar_senha_forte
# Host "postgres" = nome do serviço no docker-compose
DATABASE_URL=postgresql+psycopg://admmendes_rotas:trocar_senha_forte@postgres:5432/admmendes_rotas_pt

# --- Redis (broker Celery + cache) ---
REDIS_PASSWORD=trocar_senha_redis
REDIS_URL=redis://:trocar_senha_redis@redis:6379/0
CELERY_BROKER_URL=redis://:trocar_senha_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:trocar_senha_redis@redis:6379/2

# --- MinIO (armazenamento de manifestos, comprovantes e personalização/branding) ---
MINIO_ROOT_USER=admmendes
MINIO_ROOT_PASSWORD=trocar_senha_minio
MINIO_ENDPOINT=minio:9000
# Endpoint usado em URLs abertas pelo navegador (sem porta — o Caddy expõe os
# buckets em /comprovantes e /manifestos no mesmo domínio público; ver infra/Caddyfile).
# Em dev local com o proxy: localhost:8088.
MINIO_PUBLIC_ENDPOINT=rotas.seudominio.com.br
MINIO_USE_SSL=false
# Esquema das URLs assinadas que o navegador acessa. Em produção, o domínio público
# fica atrás de TLS (Cloudflare Tunnel + Caddy) mesmo com MINIO_USE_SSL=false
# internamente — por isso este flag é separado. Em dev local, deixe false.
MINIO_PUBLIC_SECURE=true
MINIO_BUCKET_MANIFESTS=manifestos
MINIO_BUCKET_PROOFS=comprovantes

# --- Segurança / JWT ---
# Gere com: openssl rand -hex 48
JWT_SECRET=trocar_chave_muito_forte_aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Microsoft Entra ID (OAuth2 / OpenID Connect) ---
AUTH_MODE=local               # local | entra  (use "local" para subir sem Microsoft)
MICROSOFT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=trocar_secret
MICROSOFT_REDIRECT_URI=https://rotas.seudominio.com.br/api/auth/callback

# --- OCR / IA (módulo isolado, motor trocável) ---
OCR_ENGINE=easyocr            # easyocr | tesseract | ai | ocrspace | custom | vision_llm | gemini
OCR_LANG=pt
OCR_MIN_CONFIDENCE=0.88
MAX_UPLOAD_MB=25

# Motor externo de leitura OCR/IA. Ative com OCR_ENGINE=ai.
# Nunca grave a chave real no Git; coloque apenas no .env do ambiente.
AI_OCR_PROVIDER=ocrspace      # ocrspace | custom | jmhelpdesk
AI_OCR_API_URL=https://api.ocr.space/parse/image
AI_OCR_API_KEY=trocar_chave_ocr_ai
AI_OCR_LANGUAGE=por
AI_OCR_TIMEOUT_SECONDS=30
AI_OCR_AUTH_TYPE=header       # header | bearer | basic | none
AI_OCR_API_KEY_HEADER=apikey
AI_OCR_BASIC_USERNAME=
AI_OCR_BASIC_PASSWORD=
AI_OCR_EXTRA_FORM_JSON={}

# Extrator ESTRUTURADO (texto OCR -> rota+paradas JSON).
#   rules = regex + base de conhecimento (offline, sem custo)
#   llm   = IA treinada na base (apps/ocr-worker/knowledge_base), via endpoint OpenAI-compatível
EXTRACTOR=rules               # rules | llm
OCR_LLM_BASE_URL=http://ollama:11434/v1
OCR_LLM_MODEL=llama3.1:8b
OCR_LLM_API_KEY=ollama
OCR_LLM_TIMEOUT=120

# Motor de IA VISUAL local (lê a imagem do manifesto direto, sem OCR prévio).
# Ative com OCR_ENGINE=vision_llm. Requer:
#   docker compose --profile llm up -d ollama
#   docker compose exec rotas_ollama ollama pull qwen2.5vl:7b
VISION_LLM_BASE_URL=http://ollama:11434
VISION_LLM_MODEL=qwen2.5vl:7b
VISION_LLM_TIMEOUT=600
VISION_LLM_NUM_CTX=16384

# Motor de IA VISUAL via Google Gemini (API gratuita, lê a imagem direto).
# Ative com OCR_ENGINE=gemini. Gere a chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=trocar_chave_gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=cole_aqui_o_token_do_tunnel

# --- Usuário administrador semente (criado no primeiro boot se AUTH_MODE=local) ---
SEED_ADMIN_EMAIL=admin@admmendes.com.br
SEED_ADMIN_PASSWORD=trocar_admin_senha
SEED_ADMIN_NAME=Administrador Global

# --- Roteirização (router_run — maestro/GraphHopper) ---
# Em dev local: http://localhost:3005. Quando o router_run entrar na mesma
# rede docker da API, troque para http://maestro:3000.
ROUTER_BASE_URL=http://localhost:3005

# --- SharePoint (Microsoft Graph) — sincronização automática da planilha
# Torre de Controle do cliente. Vazio = sincronização desativada.
# Requer um app registrado no Entra ID do TENANT DO CLIENTE com permissão
# de aplicação Files.Read.All (ou Sites.Read.All), consentida pelo admin.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Link de compartilhamento do arquivo (Excel Online "Compartilhar" -> Copiar link)
SHAREPOINT_FILE_URL=
# Filial (branch_id) e endereço de origem usados para a importação automática.
SHAREPOINT_SYNC_BRANCH_ID=
SHAREPOINT_SYNC_ORIGIN_ADDRESS=
