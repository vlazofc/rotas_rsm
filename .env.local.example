APP_ENV=development
APP_ENV_FILE=.env.local.example
APP_DEBUG=false
RUN_DB_BOOTSTRAP=true
AUTH_MODE=local
POSTGRES_DB=adimax_local
POSTGRES_USER=adimax_local
POSTGRES_PASSWORD=local_postgres_change_me
DATABASE_URL=postgresql+psycopg://adimax_local:local_postgres_change_me@postgres:5432/adimax_local
API_WORKERS=8
# Limite total da API: 8 workers x (5 + 5) = até 80 conexões,
# abaixo do padrão de 100 conexões do PostgreSQL local.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
REDIS_PASSWORD=local_redis_change_me
REDIS_URL=redis://:local_redis_change_me@redis:6379/0
CELERY_BROKER_URL=redis://:local_redis_change_me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:local_redis_change_me@redis:6379/2
MINIO_ROOT_USER=adimax_local
MINIO_ROOT_PASSWORD=local_minio_change_me
MINIO_ENDPOINT=minio:9000
JWT_SECRET=local-only-jwt-secret-with-at-least-32-chars
DATA_ENCRYPTION_KEY=local-only-data-key-with-at-least-32-chars
INTEGRATION_ENCRYPTION_KEY=local-only-integration-key-32-chars
SEED_ADMIN_EMAIL=admin.local@example.com
SEED_ADMIN_PASSWORD=LocalAdminChangeMe123!
SEED_ADMIN_NAME=Administrador Local
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088
WEB_BIND_ADDRESS=127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN_ROTAS=disabled-local
